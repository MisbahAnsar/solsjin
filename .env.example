# Copy to .env.local. Every value is optional.
# NEXT_PUBLIC_* values are inlined into the browser bundle. Never put a private key in one.

# RPC endpoints per cluster. Public endpoints are rate limited; use a provider (Helius, Triton,
# QuickNode...) in production. An RPC with the DAS API enables full NFT metadata in <NftGallery />.
NEXT_PUBLIC_SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_DEVNET=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_TESTNET=https://api.testnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_LOCALNET=http://127.0.0.1:8899

# Jupiter (swap quotes + token prices). Keyless use of api.jup.ag is rate limited.
NEXT_PUBLIC_JUPITER_API_URL=https://api.jup.ag
NEXT_PUBLIC_JUPITER_API_KEY=

# ---------------------------------------------------------------- Coming soon & launch (server only)
# Gate: every page shows the coming-soon page and other APIs 404. ON when unset; set to false to open the site.
COMING_SOON=true
# Optional: visit https://solsjin.com/?preview=<PREVIEW_SECRET> to see the full site while gated (12+ chars).
# /?preview=off clears it.
PREVIEW_SECRET=
# Postgres connection string for the waitlist (Neon or Supabase). The table is created on first use.
DATABASE_URL=
# Password for /admin/launch (12+ chars). Also signs admin sessions and unsubscribe links, so keep it stable.
ADMIN_SECRET=
# Resend: API key and a sender on a domain you've verified in Resend. Without the key, sends are dry runs.
RESEND_API_KEY=
EMAIL_FROM="solsjin <hello@solsjin.com>"
# Optional email caps (Resend free plan: 100/day, 3000/month). Launch sends pause at the cap and resume next day.
# EMAIL_DAILY_LIMIT=100
# EMAIL_MONTHLY_LIMIT=3000
# Public URL used in metadata, OG tags and email links.
NEXT_PUBLIC_SITE_URL=https://solsjin.com
