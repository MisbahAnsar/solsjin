# Copy to .env.local. Every value is optional: the public defaults below are used when unset.
# These are NEXT_PUBLIC_* so they are inlined into the browser bundle. Never put a private key here.

# RPC endpoints per cluster. Public endpoints are rate limited; use a provider (Helius, Triton,
# QuickNode...) in production. An RPC with the DAS API enables full NFT metadata in <NftGallery />.
NEXT_PUBLIC_SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_DEVNET=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_TESTNET=https://api.testnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_LOCALNET=http://127.0.0.1:8899

# Jupiter (swap quotes + token prices). Keyless use of api.jup.ag is rate limited.
NEXT_PUBLIC_JUPITER_API_URL=https://api.jup.ag
NEXT_PUBLIC_JUPITER_API_KEY=
